[Unit]
Description=Kylin Memory Service
After=network.target
Documentation=https://github.com/Kylin-Agent-Competition/kylinOS-agent-memory

[Service]
Type=simple
# ExecStart 指向 memory-service 目录下的 main.py 入口
# 当前为占位模板，__REPO_ROOT__ 由安装脚本在安装时替换为实际仓库路径
ExecStart=__REPO_ROOT__/.venv/bin/python __REPO_ROOT__/memory-service/main.py
WorkingDirectory=__REPO_ROOT__
Environment="LD_LIBRARY_PATH=/usr/lib/kylin-ai/depends"
Environment="PYTHONUNBUFFERED=1"
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.local/state/kylin-memory/service.log
StandardError=append:%h/.local/state/kylin-memory/service.log

[Install]
WantedBy=default.target
