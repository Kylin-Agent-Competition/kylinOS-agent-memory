#!/usr/bin/env python3
"""
V7 一键部署与测试脚本 — 通过 SSH 在麒麟 VM 上执行全链路验证
============================================================
用法:
  python v7_deploy_and_test.py [--skip-deploy] [--skip-create-user]
"""

import os
import sys
import time
import json
import io
import hashlib

try:
    import paramiko
except ImportError:
    print("需要 paramiko 库: pip install paramiko")
    sys.exit(1)

# ---- 连接配置 ----
HOST = "127.0.0.1"
PORT = 2222
USER = "REDACTED_VM_USER"
PASSWORD = "REDACTED_VM_PASSWORD"
REMOTE_BASE = f"/home/{USER}/kylin-memory-echo"

# ---- 本地文件映射 (源 -> 远程目标) ----
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_DIR = os.path.dirname(SCRIPT_DIR)  # os-agent-integration
ROOT_DIR = os.path.dirname(PROJECT_DIR)  # UDS-Kylin-Echo

FILES_TO_DEPLOY = [
    # 服务端
    (os.path.join(PROJECT_DIR, "echo", "memory_echo_server.py"), f"{REMOTE_BASE}/bin/kylin-memory-echo-server"),
    # 客户端源码
    (os.path.join(PROJECT_DIR, "echo", "echo_client.cpp"), f"{REMOTE_BASE}/echo_client.cpp"),
    (os.path.join(PROJECT_DIR, "echo", "kaiming_memory_client.cpp"), f"{REMOTE_BASE}/kaiming_memory_client.cpp"),
    # 脚本
    (os.path.join(PROJECT_DIR, "echo", "kysec_authorize.sh"), f"{REMOTE_BASE}/share/kysec_authorize.sh"),
    (os.path.join(PROJECT_DIR, "echo", "test_rollback.sh"), f"{REMOTE_BASE}/share/test_rollback.sh"),
    (os.path.join(PROJECT_DIR, "echo", "test_kysec_full.sh"), f"{REMOTE_BASE}/share/test_kysec_full.sh"),
    (os.path.join(PROJECT_DIR, "echo", "test_systemd_lifecycle.sh"), f"{REMOTE_BASE}/share/test_systemd_lifecycle.sh"),
    # Systemd unit
    (os.path.join(ROOT_DIR, "packaging", "systemd", "kylin-memory-echo.service"), f"{REMOTE_BASE}/share/kylin-memory-echo.service"),
    # V7 证据收集脚本
    (os.path.join(ROOT_DIR, "evidence", "gate0_echo", "v7_e2e_test.py"), f"{REMOTE_BASE}/evidence/v7_e2e_test.py"),
]

EVIDENCE_LOCAL_DIR = os.path.join(ROOT_DIR, "evidence", "gate0_echo")


def log(msg):
    print(f"[V7-DEPLOY] {msg}", flush=True)


class KylinDeployer:
    def __init__(self):
        self.client = paramiko.SSHClient()
        self.client.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    def connect(self):
        log(f"Connecting to {USER}@{HOST}:{PORT}...")
        for attempt in range(3):
            try:
                self.client.connect(
                    HOST, port=PORT, username=USER, password=PASSWORD,
                    timeout=15, allow_agent=False, look_for_keys=False
                )
                log("Connected!")
                return
            except Exception as e:
                log(f"  Attempt {attempt+1}/3 failed: {e}")
                if attempt < 2:
                    time.sleep(3)
        raise RuntimeError("Failed to connect after 3 attempts")

    def exec_cmd(self, cmd, timeout=60, sudo=False):
        """Execute command on remote, return (exit_code, stdout, stderr)"""
        if sudo and USER != "root":
            # Use sudo with password via stdin
            full_cmd = f"echo '{PASSWORD}' | sudo -S bash -c '{cmd}' 2>&1"
        else:
            full_cmd = cmd

        log(f"  EXEC: {cmd[:120]}...")
        stdin, stdout, stderr = self.client.exec_command(full_cmd, timeout=timeout)
        exit_code = stdout.channel.recv_exit_status()
        out = stdout.read().decode("utf-8", errors="replace")
        err = stderr.read().decode("utf-8", errors="replace")
        return exit_code, out, err

    def sftp_put(self, local_path, remote_path):
        """Upload a file via SFTP"""
        sftp = self.client.open_sftp()
        try:
            # Create remote directory if needed
            remote_dir = os.path.dirname(remote_path)
            try:
                sftp.stat(remote_dir)
            except FileNotFoundError:
                sftp.mkdir(remote_dir)

            sftp.put(local_path, remote_path)
            sftp.chmod(remote_path, 0o755)
            log(f"  UPLOAD: {os.path.basename(local_path)} -> {remote_path}")
        finally:
            sftp.close()

    def sftp_get(self, remote_path, local_path):
        """Download a file via SFTP"""
        sftp = self.client.open_sftp()
        try:
            os.makedirs(os.path.dirname(local_path), exist_ok=True)
            sftp.get(remote_path, local_path)
            log(f"  DOWNLOAD: {remote_path} -> {local_path}")
        finally:
            sftp.close()

    def close(self):
        self.client.close()


def main():
    import argparse
    parser = argparse.ArgumentParser(description="V7 Kaiming-UDS 端到端部署与测试")
    parser.add_argument("--skip-deploy", action="store_true", help="跳过文件部署")
    parser.add_argument("--skip-create-user", action="store_true", help="跳过创建 kylin-aiassistant 用户")
    parser.add_argument("--steps", choices=["all","deploy","create_user","compile","test","collect"],
                        default="all", help="执行指定步骤")
    args = parser.parse_args()

    deployer = KylinDeployer()
    results = []

    try:
        deployer.connect()

        # ---- Step 1: Create kylin-aiassistant user ----
        if args.steps in ("all", "create_user") and not args.skip_create_user:
            log("\n========== Step 1: 创建 kylin-aiassistant 测试用户 ==========")
            rc, out, err = deployer.exec_cmd(
                "id kylin-aiassistant 2>/dev/null && echo 'USER_EXISTS' || "
                "(useradd -m -s /bin/bash kylin-aiassistant && echo 'kylin-aiassistant:REDACTED_TEST_PASSWORD' | chpasswd && echo 'USER_CREATED')",
                sudo=True
            )
            log(f"  User check/create: {out.strip()}")

        # ---- Step 2: Deploy files ----
        if args.steps in ("all", "deploy") and not args.skip_deploy:
            log("\n========== Step 2: 部署文件 ==========")
            # Create remote directories
            deployer.exec_cmd(f"mkdir -p {REMOTE_BASE}/bin {REMOTE_BASE}/share {REMOTE_BASE}/logs {REMOTE_BASE}/evidence")
            for local, remote in FILES_TO_DEPLOY:
                if os.path.exists(local):
                    deployer.sftp_put(local, remote)
                else:
                    log(f"  SKIP (missing): {local}")

        # ---- Step 3: Compile clients ----
        if args.steps in ("all", "compile"):
            log("\n========== Step 3: 编译 C++ 客户端 ==========")
            # echo_client
            rc, out, err = deployer.exec_cmd(
                f"cd {REMOTE_BASE} && g++ -std=c++17 -O2 echo_client.cpp -o bin/echo_client 2>&1 && echo 'ECHO_CLIENT_OK' || echo 'ECHO_CLIENT_FAIL'"
            )
            log(f"  echo_client: {out.strip()}")
            if "FAIL" in out:
                log(f"  stderr: {err[:500]}")

            # kaiming_memory_client
            rc, out, err = deployer.exec_cmd(
                f"cd {REMOTE_BASE} && g++ -std=c++17 -O2 kaiming_memory_client.cpp -o bin/kaiming_memory_client 2>&1 && echo 'KAIMING_CLIENT_OK' || echo 'KAIMING_CLIENT_FAIL'"
            )
            log(f"  kaiming_memory_client: {out.strip()}")
            if "FAIL" in out:
                log(f"  stderr: {err[:500]}")

            # Set permissions
            deployer.exec_cmd(f"chmod +x {REMOTE_BASE}/bin/*")
            deployer.exec_cmd(f"chmod +x {REMOTE_BASE}/share/*.sh")
            deployer.exec_cmd(f"chmod +x {REMOTE_BASE}/evidence/*.py")

        # ---- Step 4: Run tests ----
        if args.steps in ("all", "test"):
            log("\n========== Step 4: 启动服务端 & 执行 V7 测试 ==========")

            # Stop any existing server
            deployer.exec_cmd("pkill -f 'kylin-memory-echo-server' 2>/dev/null || true", sudo=True)
            deployer.exec_cmd("rm -f /tmp/kylin-memory-echo/echo.sock")
            time.sleep(1)

            # Start server in background
            deployer.exec_cmd(
                f"cd {REMOTE_BASE} && nohup python3 bin/kylin-memory-echo-server > logs/server_stdout.log 2> logs/server_stderr.log &"
            )
            time.sleep(3)

            # Verify server is running
            rc, out, err = deployer.exec_cmd("pgrep -f 'kylin-memory-echo-server' || echo 'NOT_RUNNING'")
            log(f"  Server status: {out.strip()}")

            if "NOT_RUNNING" in out:
                log("  ERROR: Server failed to start!")
                # Check stderr
                rc, out, err = deployer.exec_cmd(f"cat {REMOTE_BASE}/logs/server_stderr.log")
                log(f"  Server stderr: {out[:500]}")
            else:
                log("  Server is running!")

                # ---- Test Phase A: Kaiming 客户端 ----
                log("\n  --- Phase A: Kaiming 客户端测试 ---")
                rc, out, err = deployer.exec_cmd(
                    f"{REMOTE_BASE}/bin/kaiming_memory_client --method all 2>&1",
                    timeout=30
                )
                log(f"  Kaiming client output ({len(out)} bytes):")
                for line in out.strip().split("\n")[-20:]:
                    log(f"    {line}")
                results.append(("V7-KAIMING", "PASS" if "RESULT" in out and "PASS" in out else "FAIL", out))

                # ---- Test Phase B: KYSEC ----
                log("\n  --- Phase B: KYSEC 三阶段验证 ---")
                rc, out, err = deployer.exec_cmd(
                    f"cd {REMOTE_BASE} && bash share/test_kysec_full.sh 2>&1",
                    timeout=60, sudo=True
                )
                log(f"  KYSEC output ({len(out)} bytes):")
                for line in out.strip().split("\n")[-15:]:
                    log(f"    {line}")
                results.append(("V7-KYSEC", "PASS" if "❌" not in out and "✅" in out else "FAIL", out))

                # ---- Test Phase C: Systemd ----
                log("\n  --- Phase C: Systemd 生命周期 ---")
                rc, out, err = deployer.exec_cmd(
                    f"cd {REMOTE_BASE} && bash share/test_systemd_lifecycle.sh 2>&1",
                    timeout=90, sudo=True
                )
                log(f"  Systemd output ({len(out)} bytes):")
                for line in out.strip().split("\n")[-15:]:
                    log(f"    {line}")
                results.append(("V7-SYSTEMD", "PASS" if "❌" not in out and "✅" in out else "FAIL", out))

                # ---- Test Phase D: V7 Python 证据收集 ----
                log("\n  --- Phase D: V7 Python 证据收集 ---")
                rc, out, err = deployer.exec_cmd(
                    f"cd {REMOTE_BASE} && python3 evidence/v7_e2e_test.py 2>&1",
                    timeout=120
                )
                log(f"  V7 e2e output ({len(out)} bytes):")
                for line in out.strip().split("\n")[-20:]:
                    log(f"    {line}")
                results.append(("V7-E2E", "PASS" if "PASS" in out else "FAIL", out))

        # ---- Step 5: Collect evidence ----
        if args.steps in ("all", "collect"):
            log("\n========== Step 5: 收集证据 ==========")
            # Download evidence.jsonl
            remote_evidence = f"{REMOTE_BASE}/evidence/gate0_echo_v7/evidence.jsonl"
            local_evidence_dir = os.path.join(EVIDENCE_LOCAL_DIR, "v7_evidence")
            os.makedirs(local_evidence_dir, exist_ok=True)

            try:
                deployer.sftp_get(remote_evidence, os.path.join(local_evidence_dir, "evidence.jsonl"))
                log(f"  evidence.jsonl downloaded to {local_evidence_dir}")
            except Exception as e:
                log(f"  WARN: Could not download evidence.jsonl: {e}")

            # Collect logs
            for log_file in ["server_stdout.log", "server_stderr.log"]:
                try:
                    deployer.sftp_get(
                        f"{REMOTE_BASE}/logs/{log_file}",
                        os.path.join(local_evidence_dir, log_file)
                    )
                except Exception:
                    pass

            # Collect KYSEC test log
            try:
                rc, out, err = deployer.exec_cmd(f"ls -t {REMOTE_BASE}/logs/test_kysec_full_*.log 2>/dev/null | head -1")
                if out.strip():
                    deployer.sftp_get(out.strip(), os.path.join(local_evidence_dir, "test_kysec_full.log"))
            except Exception:
                pass

            # Collect systemd test log
            try:
                rc, out, err = deployer.exec_cmd(f"ls -t {REMOTE_BASE}/logs/test_systemd_lifecycle_*.log 2>/dev/null | head -1")
                if out.strip():
                    deployer.sftp_get(out.strip(), os.path.join(local_evidence_dir, "test_systemd_lifecycle.log"))
            except Exception:
                pass

            log(f"\n  证据已收集到: {local_evidence_dir}")

        # ---- Summary ----
        log("\n" + "="*50)
        log(" V7 部署与测试汇总")
        log("="*50)
        for name, status, _ in results:
            emoji = "✅" if status == "PASS" else "❌"
            log(f"  {emoji} {name}: {status}")
        log("="*50)

    except Exception as e:
        log(f"ERROR: {e}")
        return 1
    finally:
        deployer.close()

    return 0


if __name__ == "__main__":
    sys.exit(main())