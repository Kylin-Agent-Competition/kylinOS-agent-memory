--- schema ---
CREATE TABLE conversations (
	id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, 
	user_id VARCHAR NOT NULL, 
	session_id VARCHAR NOT NULL, 
	started_at VARCHAR NOT NULL, 
	ended_at VARCHAR, 
	UNIQUE (session_id)
);
CREATE TABLE sqlite_sequence(name,seq);
CREATE TABLE outbox (
	id INTEGER NOT NULL, 
	aggregate_type VARCHAR NOT NULL, 
	aggregate_id VARCHAR NOT NULL, 
	event_type VARCHAR NOT NULL, 
	payload TEXT NOT NULL, 
	attempts INTEGER NOT NULL, 
	next_retry_at VARCHAR, 
	last_error TEXT, 
	created_at VARCHAR NOT NULL, 
	PRIMARY KEY (id), 
	CONSTRAINT ck_outbox_aggregate_type CHECK (aggregate_type IN ('turn','memory'))
);
CREATE INDEX idx_outbox_pending ON outbox (next_retry_at) WHERE attempts <= 3;
CREATE TABLE idempotency_cache (
	user_id VARCHAR NOT NULL, 
	session_id VARCHAR NOT NULL, 
	idempotency_key VARCHAR NOT NULL, 
	response TEXT NOT NULL, 
	created_at VARCHAR NOT NULL, 
	expires_at VARCHAR NOT NULL, 
	PRIMARY KEY (user_id, session_id, idempotency_key)
);
CREATE INDEX idx_idempotency_expires ON idempotency_cache (expires_at);
CREATE TABLE turns (
	id INTEGER NOT NULL, 
	session_id VARCHAR NOT NULL, 
	turn_index INTEGER NOT NULL, 
	original_user_text TEXT NOT NULL, 
	model_request TEXT, 
	model_response TEXT, 
	is_end INTEGER NOT NULL, 
	created_at VARCHAR NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(session_id) REFERENCES conversations (session_id)
);
CREATE INDEX idx_turns_session ON turns (session_id, turn_index);
CREATE TABLE memory_entries (
	id INTEGER NOT NULL, 
	user_id VARCHAR NOT NULL, 
	entry_type VARCHAR NOT NULL, 
	content TEXT NOT NULL, 
	source_turn_id INTEGER, 
	confidence FLOAT NOT NULL, 
	version INTEGER NOT NULL, 
	is_deleted INTEGER NOT NULL, 
	created_at VARCHAR NOT NULL, 
	updated_at VARCHAR NOT NULL, 
	PRIMARY KEY (id), 
	CONSTRAINT ck_memory_entries_entry_type CHECK (entry_type IN ('preference','knowledge','tool_result','behavior')), 
	CONSTRAINT ck_memory_entries_confidence CHECK (confidence >= 0 AND confidence <= 1), 
	FOREIGN KEY(source_turn_id) REFERENCES turns (id)
);
CREATE INDEX idx_memory_user_type ON memory_entries (user_id, entry_type);
CREATE INDEX idx_memory_deleted ON memory_entries (is_deleted);
CREATE VIRTUAL TABLE memory_fts USING fts5(content, entry_type, user_id UNINDEXED, tokenize='unicode61')
/* memory_fts(content,entry_type,user_id) */;
CREATE TABLE IF NOT EXISTS 'memory_fts_data'(id INTEGER PRIMARY KEY, block BLOB);
CREATE TABLE IF NOT EXISTS 'memory_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID;
CREATE TABLE IF NOT EXISTS 'memory_fts_content'(id INTEGER PRIMARY KEY, c0, c1, c2);
CREATE TABLE IF NOT EXISTS 'memory_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB);
CREATE TABLE IF NOT EXISTS 'memory_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID;
CREATE TRIGGER memory_fts_ai AFTER INSERT ON memory_entries BEGIN
        INSERT INTO memory_fts(rowid, content, entry_type, user_id)
        VALUES (new.id, new.content, new.entry_type, new.user_id);
    END;
CREATE TRIGGER memory_fts_au_content AFTER UPDATE ON memory_entries
    WHEN old.is_deleted = 0 AND new.is_deleted = 0 AND old.content IS NOT new.content
    BEGIN
        DELETE FROM memory_fts WHERE rowid = old.id;
        INSERT INTO memory_fts(rowid, content, entry_type, user_id)
        VALUES (new.id, new.content, new.entry_type, new.user_id);
    END;
CREATE TRIGGER memory_fts_au_deleted AFTER UPDATE ON memory_entries
    WHEN old.is_deleted = 0 AND new.is_deleted = 1
    BEGIN
        DELETE FROM memory_fts WHERE rowid = old.id;
    END;
CREATE TRIGGER memory_fts_ad AFTER DELETE ON memory_entries BEGIN
        DELETE FROM memory_fts WHERE rowid = old.id;
    END;

