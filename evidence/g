# ---- 配置 ----
SOCKET_PATH = "/tmp/kylin-memory-echo/echo.sock"
SOCKET_DIR = "/tmp/kylin-memory-echo"
DEPLOY_BASE = os.path.expanduser("~/kylin-memory-echo")
OUTPUT_DIR = os.path.join(DEPLOY_BASE, "evidence", "gate0_echo_v7")
SERVER_SCRIPT = os.path.join(DEPLOY_BASE, "bin", "kylin-memory-echo-server")
KAIMING_CLIENT = os.path.join(DEPLOY_BASE, "bin", "kaiming_memory_client")
ECHO_CLIENT = os.path.join(DEPLOY_BASE, "bin", "echo_client")
KY_SEC_SCRIPT = os.path.join(DEPLOY_BASE, "share", "kysec_authorize.sh")
KY_SEC_FULL_SCRIPT = os.path.join(DEPLOY_BASE, "share", "test_kysec_full.sh")
SYSTEMD_LIFECYCLE_SCRIPT = os.path.join(DEPLOY_BASE, "share", "test_systemd_lifecycle.sh")
PROTOCOL_VERSION = "1.0"

RESULTS: Dict[str, int] = {"pass": 0, "fail": 0, "skip": 0}
EVIDENCE_FILE = os.path.join(OUTPUT_DIR, "evidence.jsonl")

# ---- 日志 ----
def log(msg: str):
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
    print(f"[{ts}] {msg}", flush=True)


# ---- 证据记录 ----
def record_evidence(test_id: str, description: str, status: str, evidence_level: str, details: dict):
    record = {
        "test_id": test_id,
        "description": description,
        "status": status,
        "evidence_level": evidence_level,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "hostname": os.uname().nodename,
        "user": os.environ.get("USER", "unknown"),
        "details": details,
    }
    with open(EVIDENCE_FILE, "a", encoding="utf-8") as f:
        f.write(json.dumps(record, ensure_ascii=False) + "\n")

    emoji = {"PASS": "✅", "FAIL": "❌", "SKIPPED": "⬜"}.get(status, "❓")
    log(f"  {emoji} {test_id}: {status} — {description}")

    RESULTS["pass" if status == "PASS" else ("fail" if status == "FAIL" else "skip")] += 1


# ---- UDS 客户端 (Python 实现) ----
def uds_send_recv(method: str, message: str = "", deadline_ms: int = 5000) -> dict:
    request = {
        "protocol_version": PROTOCOL_VERSION,
        "request_id": f"req_v7_{int(time.time() * 1000)}",
        "trace_id": f"trc_v7_{int(time.time() * 1000)}",
        "method": method,
        "deadline_ms": deadline_ms,
        "payload": {"message": message},
    }
    body = json.dumps(request, ensure_ascii=False).encode("utf-8")
    header = struct.pack(">I", len(body))

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(5.0)
    try:
        sock.connect(SOCKET_PATH)
        sock.sendall(header + body)
        raw_len = b""
        while len(raw_len) < 4:
            chunk = sock.recv(4 - len(raw_len))
            if not chunk:
                raise ConnectionError("Server disconnected")
            raw_len += chunk
        resp_len = struct.unpack(">I", raw_len)[0]
        raw_body = b""
        while len(raw_body) < resp_len:
            chunk = sock.recv(resp_len - len(raw_body))
            if not chunk:
                raise ConnectionError("Server disconnected")
            raw_body += chunk
        return json.loads(raw_body.decode("utf-8"))
    finally:
        sock.close()


def compute_state_sha256() -> str:
    """计算当前 socket/KYSEC 状态的 SHA-256"""
    state_lines = []
    if os.path.isdir(SOCKET_DIR):
        result = subprocess.run(["ls", "-la", SOCKET_DIR], capture_output=True, text=True)
        state_lines.append(result.stdout)
        result = subprocess.run(["stat", SOCKET_DIR], capture_output=True, text=True)
        state_lines.append(result.stdout)
    if os.path.exists(SOCKET_PATH):
        result = subprocess.run(["stat", SOCKET_PATH], capture_output=True, text=True)
        state_lines.append(result.stdout)
    kysec_dir = "/sys/kernel/security/kylin"
    if os.path.isdir(kysec_dir):
        for f in sorted(os.listdir(kysec_dir)):
            fp = os.path.join(kysec_dir, f)
            if os.path.isfile(fp):
                try:
                    with open(fp) as fh:
                        state_lines.append(f"{f}: {fh.read().strip()}")
                except Exception:
                    pass
    return hashlib.sha256("\n".join(state_lines).encode()).hexdigest()


# ---- Phase 0: 系统基线 ----
def phase0_baseline():
    log("\n========== Phase 0: 系统基线 ==========")

    uname = subprocess.run(["uname", "-a"], capture_output=True, text=True).stdout.strip()
    hostname = os.uname().nodename
    user = os.environ.get("USER", "unknown")

    record_evidence("V7-SYS-001", "系统基线采集", "PASS", "E4", {
        "uname": uname, "hostname": hostname, "user": user,
    })

    sha = compute_state_sha256()
    record_evidence("V7-SYS-002", "部署前 SHA-256 基线", "PASS", "E4", {
        "sha256_before": sha,
    })

    # 确认 kylin-aiassistant 用户
    result = subprocess.run(["id", "kylin-aiassistant"], capture_output=True, text=True)
    if result.returncode == 0:
        record_evidence("V7-SYS-003", "kylin-aiassistant 用户存在", "PASS", "E4", {
            "id_output": result.stdout.strip(),
        })
    else:
        record_evidence("V7-SYS-003", "kylin-aiassistant 用户不存在", "FAIL", "E0", {
            "error": "需要先创建 kylin-aiassistant 测试账户",
        })


# ---- Phase A: Kaiming 宿主进程 UDS 通信 ----
def phase_a_kaiming_uds():
    log("\n========== Phase A: Kaiming 宿主进程 UDS 通信 ==========")

    # A.1 确认 kaiming_memory_client 已编译
    if os.path.isfile(KAIMING_CLIENT) and os.access(KAIMING_CLIENT, os.X_OK):
        result = subprocess.run(["file", KAIMING_CLIENT], capture_output=True, text=True)
        record_evidence("V7-KAIMING-001", "Kaiming 客户端二进制存在", "PASS", "E4", {
            "file_output": result.stdout.strip(),
            "binary_path": KAIMING_CLIENT,
        })
    else:
        record_evidence("V7-KAIMING-001", "Kaiming 客户端二进制不存在", "FAIL", "E0", {
            "error": f"{KAIMING_CLIENT} not found or not executable"
        })
        return

    # A.2 Kaiming 客户端全量测试 (echo/health/retrieve/store/unknown/rapid)
    result = subprocess.run(
        [KAIMING_CLIENT, "--method", "all"],
        capture_output=True, text=True, timeout=30
    )
    output = result.stdout + "\n" + result.stderr
    pass_count = output.count("PASS")
    fail_count = output.count("FAIL")

    if fail_count == 0 and pass_count > 0:
        record_evidence("V7-KAIMING-002", "Kaiming 全量 UDS 测试", "PASS", "E4", {
            "exit_code": result.returncode,
            "pass_count": pass_count,
            "fail_count": fail_count,
            "output_tail": output[-2000:],
        })
    else:
        record_evidence("V7-KAIMING-002", "Kaiming 全量 UDS 测试", "FAIL", "E4", {
            "exit_code": result.returncode,
            "pass_count": pass_count,
            "fail_count": fail_count,
            "output_tail": output[-2000:],
        })

    # A.3 以 kylin-aiassistant 用户身份测试 (如果用户存在)
    result_check = subprocess.run(["id", "kylin-aiassistant"], capture_output=True, text=True)
    if result_check.returncode == 0:
        result = subprocess.run(
            ["sudo", "-u", "kylin-aiassistant", KAIMING_CLIENT, "--method", "echo", "--message", "KaimingUserTest"],
            capture_output=True, text=True, timeout=15
        )
        ok = "PASS" in result.stdout and "FAIL" not in result.stdout
        record_evidence("V7-KAIMING-003", "kylin-aiassistant 用户 UDS 访问", "PASS" if ok else "FAIL", "E4", {
            "exit_code": result.returncode,
            "output_tail": (result.stdout + result.stderr)[-1000:],
        })
    else:
        record_evidence("V7-KAIMING-003", "kylin-aiassistant 用户 UDS 访问", "SKIPPED", "E0", {
            "reason": "kylin-aiassistant 用户不存在",
        })


# ---- Phase B: KYSEC 完整三阶段验证 ----
def phase_b_kysec():
    log("\n========== Phase B: KYSEC 完整三阶段验证 ==========")

    sha_before = compute_state_sha256()

    # B.1 执行完整 KYSEC 测试
    if os.path.isfile(KY_SEC_FULL_SCRIPT):
        result = subprocess.run(
            ["sudo", "bash", KY_SEC_FULL_SCRIPT],
            capture_output=True, text=True, timeout=60
        )
        output = result.stdout + "\n" + result.stderr
        pass_count = output.count("✅")
        fail_count = output.count("❌")

        record_evidence("V7-KYSEC-001", "KYSEC 三阶段验证 (完整脚本)", "PASS" if fail_count == 0 else "FAIL", "E4", {
            "exit_code": result.returncode,
            "pass_count": pass_count,
            "fail_count": fail_count,
            "output_tail": output[-3000:],
        })
    else:
        # 简化版 KYSEC 验证
        log("  KYSEC 完整脚本不存在，执行简化验证...")

        # B.2 授权前基线
        sha_before = compute_state_sha256()
        record_evidence("V7-KYSEC-002a", "KYSEC 授权前 SHA-256", "PASS", "E4", {
            "sha256": sha_before,
        })

        # B.3 执行 ACL 设置
        result = subprocess.run(
            ["sudo", "bash", KY_SEC_SCRIPT, "authorize"],
            capture_output=True, text=True, timeout=15
        )
        record_evidence("V7-KYSEC-002b", "KYSEC ACL 授权", "PASS" if result.returncode == 0 else "FAIL", "E3", {
            "exit_code": result.returncode,
            "output": result.stdout[-500:],
        })

        # B.4 授权后验证
        if os.path.isfile(KAIMING_CLIENT):
            result = subprocess.run(
                ["sudo", "-u", "kylin-aiassistant", KAIMING_CLIENT, "--method", "echo", "--message", "PostKYSEC"],
                capture_output=True, text=True, timeout=15
            )
            ok = "PASS" in result.stdout
            record_evidence("V7-KYSEC-003", "KYSEC 授权后 kylin-aiassistant 访问", "PASS" if ok else "FAIL", "E4", {
                "exit_code": result.returncode,
                "output": (result.stdout + result.stderr)[-500:],
            })

        # B.5 回退
        result = subprocess.run(
            ["sudo", "bash", KY_SEC_SCRIPT, "rollback"],
            capture_output=True, text=True, timeout=15
        )
        record_evidence("V7-KYSEC-004", "KYSEC 回退执行", "PASS" if result.returncode == 0 else "FAIL", "E3", {
            "exit_code": result.returncode,
            "output": result.stdout[-500:],
        })

        # B.6 回退后 SHA-256
        sha_after = compute_state_sha256()
        record_evidence("V7-KYSEC-005", "KYSEC 回退后 SHA-256 对比", "PASS" if sha_before == sha_after else "FAIL", "E4", {
            "sha256_before": sha_before,
            "sha256_after": sha_after,
            "match": sha_before == sha_after,
        })


# ---- Phase C: Systemd 完整生命周期 ----
def phase_c_systemd():
    log("\n========== Phase C: Systemd 完整生命周期 ==========")

    if os.path.isfile(SYSTEMD_LIFECYCLE_SCRIPT):
        result = subprocess.run(
            ["sudo", "bash", SYSTEMD_LIFECYCLE_SCRIPT],
            capture_output=True, text=True, timeout=90
        )
        output = result.stdout + "\n" + result.stderr
        pass_count = output.count("✅")
        fail_count = output.count("❌")

        record_evidence("V7-SYSTEMD-001", "Systemd 生命周期测试 (完整脚本)", "PASS" if fail_count == 0 else "FAIL", "E4", {
            "exit_code": result.returncode,
            "pass_count": pass_count,
            "fail_count": fail_count,
            "output_tail": output[-3000:],
        })
    else:
        # 简化版 systemd 验证
        log("  Systemd 测试脚本不存在，执行简化验证...")
        result = subprocess.run(
            ["systemctl", "list-unit-files", "--type=service"],
            capture_output=True, text=True
        )
        if "kylin-memory-echo" in result.stdout:
            record_evidence("V7-SYSTEMD-001", "Systemd unit 已注册", "PASS", "E4", {
                "found": True,
            })
        else:
            record_evidence("V7-SYSTEMD-001", "Systemd unit 未注册", "SKIPPED", "E3", {
                "found": False,
            })


# ---- Phase D: 最终汇总 ----
def phase_d_summary():
    log("\n========== Phase D: 最终汇总 ==========")
    total = RESULTS["pass"] + RESULTS["fail"] + RESULTS["skip"]
    log(f"  通过: {RESULTS['pass']}")
    log(f"  失败: {RESULTS['fail']}")
    log(f"  跳过: {RESULTS['skip']}")
    log(f"  总计: {total}")
    log(f"\n  证据文件: {EVIDENCE_FILE}")

    # 写出汇总记录
    record_evidence("V7-SUMMARY", "V7 全链路端到端测试汇总", "PASS" if RESULTS["fail"] == 0 else "FAIL", "E4", {
        "summary": dict(RESULTS),
        "evidence_file": EVIDENCE_FILE,
        "phases_executed": [
            "Phase 0: 系统基线",
            "Phase A: Kaiming 宿主进程 UDS 通信",
            "Phase B: KYSEC 三阶段验证",
            "Phase C: Systemd 生命周期",
            "Phase D: 汇总",
        ],
    })


# ---- 主入口 ----
def main():
    os.makedirs(OUTPUT_DIR, exist_ok=True)

    # 清空旧的 evidence.jsonl
    if os.path.exists(EVIDENCE_FILE):
        os.remove(EVIDENCE_FILE)

    log("============================================")
    log(" V7 Kaiming→UDS 端到端全链路验证 — P1-1")
    log(f" 证据输出: {OUTPUT_DIR}")
    log(f" 开始时间: {datetime.now(timezone.utc).isoformat()}")
    log("============================================")

    # 确保服务端运行
    log("\n确保 Echo Server 运行...")
    if subprocess.run(["pgrep", "-f", "kylin-memory-echo-server"], capture_output=True).returncode != 0:
        log("  启动 Echo Server...")
        subprocess.Popen(
            ["python3", SERVER_SCRIPT],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        time.sleep(2)

    phase0_baseline()
    phase_a_kaiming_uds()
    phase_b_kysec()
    phase_c_systemd()
    phase_d_summary()

    log(f"\n{'='*40}")
    log(f" 全部完成! 证据文件: {EVIDENCE_FILE}")
    log(f"{'='*40}")

    return 0 if RESULTS["fail"] == 0 else 1


if __name__ == "__main__":
    sys.exit(main())