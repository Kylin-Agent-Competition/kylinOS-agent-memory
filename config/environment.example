# 环境变量示例
# 复制为 .env 后填入实际值。.env 不会进入版本控制。

# 项目根目录
KMA_PROJECT_ROOT=

# Memory Service Unix Domain Socket 路径
KMA_SOCKET_PATH=/tmp/kylin-memory-service.sock

# SQLite 数据库路径
KMA_DATABASE_PATH=

# 日志级别: DEBUG, INFO, WARNING, ERROR
KMA_LOG_LEVEL=INFO

# 检索超时 (毫秒)
KMA_RETRIEVE_DEADLINE_MS=150

# 推送上下文最大 token 数
KMA_MAX_CONTEXT_TOKENS=800

# ======== UDS Echo 组件路径 (os-agent-integration/echo) ========
# 注意: 以下路径区分 dev 模式与 systemd/prod 模式
# 统一部署布局 (Gate 0): /home/<user>/kylin-memory-echo/
#
# ---- 统一部署布局 (Gate 0) ----
# /home/<user>/kylin-memory-echo/
# ├── bin/
# │   ├── kylin-memory-echo-server    (服务端脚本)
# │   ├── echo_client                 (C++ 客户端)
# │   └── kaiming_memory_client       (Kaiming 模拟客户端)
# ├── share/
# │   └── kylin-memory-echo.service   (仓库正式 Unit)
# ├── logs/
# └── build/
#
# ---- UDS Socket 路径 (按运行模式区分) ----
# systemd 模式: /run/kylin-memory-echo/echo.sock
# dev 模式:     /tmp/kylin-memory-echo/echo.sock  (传递 --dev 或 --socket 参数)
#
# ---- 服务端脚本 dev 路径 (未安装时从仓库直接运行) ----
# os-agent-integration/echo/memory_echo_server.py --dev

# ======== SSH 远程 VM 连接凭据 (evidence/gate0_echo/*.py 使用) ========
# 麒麟 VM SSH 主机地址
KYLIN_VM_HOST=127.0.0.1

# 麒麟 VM SSH 端口
KYLIN_VM_PORT=2222

# 麒麟 VM SSH 用户名
KYLIN_VM_USER=kylin-agent

# 麒麟 VM SSH 密码（必填，运行证据收集脚本前必须设置）
KYLIN_VM_PASSWORD=
