# 环境变量示例（R-3 定案：KMA_* → KYLIN_MEMORY_*，与冻结 FRZ-CFG-001 对齐）
# 复制为 .env 后填入实际值。.env 不会进入版本控制。
# 优先级：CLI > 环境变量 > config.toml > 默认值

# ── Memory Service 配置（FRZ-CFG-001 8 键全量映射，FR-DB-006） ──

# UDS Socket 路径（默认 $XDG_RUNTIME_DIR/kylin-memory/memory.sock）
KYLIN_MEMORY_SOCKET=

# SQLite 数据库路径（默认 ~/.local/share/kylin-memory/kylin_memory.db）
KYLIN_MEMORY_DB=

# 默认 deadline（毫秒，正整数 1..60000）
KYLIN_MEMORY_DEADLINE_MS=5000

# 检索 deadline（毫秒，正整数 1..5000；聊天优先：超时返回空上下文）
KYLIN_MEMORY_RETRIEVE_DEADLINE_MS=150

# Outbox 轮询间隔（秒，正整数 1..60）
KYLIN_MEMORY_OUTBOX_POLL_INTERVAL_S=1

# Outbox 最大重试次数（正整数 1..10；默认保持 3，偏离须走 ADR 同步评估索引）
KYLIN_MEMORY_OUTBOX_MAX_RETRIES=3

# Embedding 模型名（非空）
KYLIN_MEMORY_EMBEDDING_MODEL=default

# 日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
KYLIN_MEMORY_LOG_LEVEL=INFO

# ======== SSH 远程 VM 连接凭据 (evidence/gate0_echo/*.py 使用) ========
# 麒麟 VM SSH 主机地址
KYLIN_VM_HOST=127.0.0.1

# 麒麟 VM SSH 端口
KYLIN_VM_PORT=2222

# 麒麟 VM SSH 用户名
KYLIN_VM_USER=kylin-agent

# 麒麟 VM SSH 密码（必填，运行证据收集脚本前必须设置）
KYLIN_VM_PASSWORD=
